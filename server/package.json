{
  "name": "shopethio-backend",
  "version": "1.0.0",
  "description": "Express backend server for ShopEthio app using Prisma and PostgreSQL",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "prisma:seed": "node prisma/seed.js",
    "docker:start": "npx prisma migrate deploy && node prisma/seed.js && node server.js"
  },
  "dependencies": {
    "@prisma/client": "^5.10.2",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.3"
  },
  "devDependencies": {
    "nodemon": "^3.1.0",
    "prisma": "^5.10.2"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "private": true
}